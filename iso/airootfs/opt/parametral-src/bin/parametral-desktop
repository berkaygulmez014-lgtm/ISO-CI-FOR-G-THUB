#!/usr/bin/env python3
"""parametral-desktop — inspect and select the desktop session.

The installer writes one answer to /etc/parametral/desktop.conf. This tool reads that answer,
shows the sessions actually present on the machine, and changes the SDDM default without
re-running the installer.

    parametral-desktop status
    parametral-desktop list
    parametral-desktop default parametral   # or: plasma
    parametral-desktop default --list

`--root /tmp/tree` is for tests and for inspecting a mounted image without chrooting.
"""
from __future__ import annotations

import argparse
import json
import os
import pwd
import sys
from pathlib import Path

CONF = "etc/parametral/desktop.conf"
SESSION_DIRS = ("usr/share/wayland-sessions", "usr/share/xsessions")
SDDM_CONF = "etc/sddm.conf.d/20-parametral-session.conf"
SDDM_STATE = "var/lib/sddm/state.conf"


def at(root: Path, path: str) -> Path:
    return root / path.lstrip("/")


def read_conf(root: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    path = at(root, CONF)
    if not path.is_file():
        return values
    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"')
    return values


def desktop_fields(path: Path) -> dict[str, str]:
    fields: dict[str, str] = {}
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return fields
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or line.startswith(";") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key.startswith("Name[") or key.startswith("Comment["):
            continue
        fields.setdefault(key, value.strip())
    return fields


def sessions(root: Path) -> list[dict[str, object]]:
    found: list[dict[str, object]] = []
    seen: set[str] = set()
    for rel in SESSION_DIRS:
        directory = at(root, rel)
        if not directory.is_dir():
            continue
        for entry in sorted(directory.glob("*.desktop")):
            fields = desktop_fields(entry)
            if fields.get("Hidden", "").lower() == "true":
                continue
            name = fields.get("Name") or entry.stem
            key = entry.stem
            if key in seen:
                continue
            seen.add(key)
            found.append({
                "name": key,
                "display": name,
                "exec": fields.get("Exec", ""),
                "file": "/" + str(entry.relative_to(root)),
                "desktop_names": fields.get("DesktopNames", ""),
            })
    return found


def find_session(root: Path, wanted: str) -> dict[str, object] | None:
    wanted = wanted.strip()
    if wanted.endswith(".desktop"):
        wanted = wanted[: -len(".desktop")]
    for item in sessions(root):
        if item["name"] == wanted:
            return item
    return None


def cmd_list(args: argparse.Namespace) -> int:
    root = Path(args.root)
    conf = read_conf(root)
    primary = conf.get("PARAMETRAL_PRIMARY_SESSION", "")
    entries = sessions(root)
    if args.json:
        print(json.dumps({"primary": primary, "sessions": entries}, indent=2))
        return 0
    if not entries:
        print("no session entries found under /usr/share/{wayland-,x}sessions")
        return 0
    for item in entries:
        marks = []
        if item["name"] == primary:
            marks.append("default")
        suffix = f" [{', '.join(marks)}]" if marks else ""
        print(f"{item['name']:<14} {item['display']:<24} {item['file']}{suffix}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    root = Path(args.root)
    conf = read_conf(root)
    if not conf:
        print("desktop=unset")
    else:
        print(f"desktop={conf.get('PARAMETRAL_DESKTOP', '')}")
        print(f"appearance={conf.get('PARAMETRAL_APPEARANCE', '')}")
        print(f"primary-session={conf.get('PARAMETRAL_PRIMARY_SESSION', '')}")
        print(f"sessions={conf.get('PARAMETRAL_SESSIONS', '')}")
    entries = sessions(root)
    print("installed:")
    if not entries:
        print("  (none)")
    for item in entries:
        print(f"  {item['name']:<14} {item['display']:<24} {item['file']}")
    greeter = at(root, "etc/sddm.conf.d/20-parametral-session.conf").is_file()
    print(f"greeter=sddm{' (configured)' if greeter else ' (not configured)'}")
    return 0


def write_sddm(root: Path, primary: str) -> None:
    conf_path = at(root, SDDM_CONF)
    conf_path.parent.mkdir(parents=True, exist_ok=True)
    conf_path.write_text(
        "# Generated by parametral-desktop — the session the greeter preselects.\n"
        "[Autologin]\n"
        f"Session={primary}\n"
    )
    os.chmod(conf_path, 0o644)

    state = at(root, SDDM_STATE)
    state.parent.mkdir(parents=True, exist_ok=True)
    last_user = ""
    if state.is_file():
        for line in state.read_text(errors="replace").splitlines():
            if line.startswith("User="):
                last_user = line.split("=", 1)[1].strip()
    body = "[Last]\n" + f"Session={primary}\n"
    if last_user:
        body += f"User={last_user}\n"
    state.write_text(body)
    os.chmod(state, 0o640)
    try:
        sddm = pwd.getpwnam("sddm")
        os.chown(state.parent, sddm.pw_uid, sddm.pw_gid)
        os.chown(state, sddm.pw_uid, sddm.pw_gid)
    except (KeyError, PermissionError):
        pass


def cmd_default(args: argparse.Namespace) -> int:
    root = Path(args.root)
    if root == Path("/") and os.geteuid() != 0:
        print("root required (try: sudo parametral-desktop default ...)", file=sys.stderr)
        return 1
    item = find_session(root, args.session)
    if item is None:
        print(f"unknown session: {args.session}", file=sys.stderr)
        names = ", ".join(str(s["name"]) for s in sessions(root)) or "none"
        print("installed sessions: " + names, file=sys.stderr)
        return 2

    primary = str(item["name"])
    write_sddm(root, primary)

    conf_path = at(root, CONF)
    conf_path.parent.mkdir(parents=True, exist_ok=True)
    if conf_path.is_file():
        lines = conf_path.read_text(errors="replace").splitlines()
        lines = [
            f"PARAMETRAL_PRIMARY_SESSION={primary}"
            if line.startswith("PARAMETRAL_PRIMARY_SESSION=") else line
            for line in lines
        ]
        if not any(line.startswith("PARAMETRAL_PRIMARY_SESSION=") for line in lines):
            lines.append(f"PARAMETRAL_PRIMARY_SESSION={primary}")
        conf_path.write_text("\n".join(lines) + "\n")
    else:
        conf_path.write_text(
            "# Parametral OS — desktop edition selection.\n"
            f"PARAMETRAL_PRIMARY_SESSION={primary}\n"
        )
    os.chmod(conf_path, 0o644)

    print(f"default session: {primary} ({item['display']})")
    print(f"written: /{SDDM_CONF}, /{SDDM_STATE}, /{CONF}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="parametral-desktop",
        description="Inspect and select the Parametral OS desktop session.",
    )
    parser.add_argument(
        "--root",
        default=os.environ.get("PARAMETRAL_ROOT", "/"),
        help="inspect this root instead of / (tests, mounted images)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="show the selected edition and installed sessions")
    status.set_defaults(func=cmd_status)

    listing = sub.add_parser("list", help="list installed session entries")
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(func=cmd_list)

    default = sub.add_parser("default", help="make a session the SDDM default")
    default.add_argument("session", help="session name, e.g. parametral or plasma")
    default.set_defaults(func=cmd_default)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
