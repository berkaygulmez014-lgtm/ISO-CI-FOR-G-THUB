#!/bin/sh
# Parametral session launcher.
#
# Two jobs:
#  1. On machines without a usable GPU (VMware SVGA, VirtualBox, QXL, virtio-gpu) Hyprland's
#     aquamarine backend dies with "CBackend::create() failed". Software GL is the difference
#     between a black screen and a desktop there. On real hardware the GPU is left alone.
#  2. Start the compositor through uwsm so the session is a proper systemd user session.
#     It goes through start-hyprland, not Hyprland: Hyprland itself warns (and paints a black
#     toast at login) when it is launched without its watchdog wrapper, and a distribution
#     should not ship a session that warns at every boot.
#
# `--` matters: without it uwsm eats --config as its own argument and the compositor starts with
# the wrong config (or not at all).

set -u

if command -v lspci >/dev/null 2>&1 && lspci 2>/dev/null | grep -qiE 'VMware SVGA|VirtualBox|QXL|virtio.*(VGA|GPU)|Bochs'; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
fi

# `--` in two places, for two different parsers: the first ends uwsm's own options so the rest
# reaches start-hyprland verbatim, the second ends start-hyprland's options so --config reaches
# Hyprland. With only one `--` the compositor silently starts on its autogenerated config.
exec uwsm start -e -D Parametral -- start-hyprland -- --config /etc/parametral/hypr/parametral.lua
