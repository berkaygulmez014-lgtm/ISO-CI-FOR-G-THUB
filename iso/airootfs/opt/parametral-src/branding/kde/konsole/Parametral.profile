[Appearance]
ColorScheme=Parametral
Font=JetBrains Mono,10,-1,5,50,0,0,0,0,0

[General]
# no Command line: Konsole uses the account's own login shell, so the profile works on
# systems where fish is not installed
Environment=TERM=xterm-256color
Name=Parametral
Parent=FALLBACK/
LocalTabTitleFormat=%d
RemoteTabTitleFormat=%h : %u

[Interaction Options]
AutoCopySelectedText=true
TrimLeadingSpacesInSelectedText=true

[Scrolling]
HistoryMode=2
ScrollBarPosition=2
