#!/usr/bin/env bash
# parametral-kde-fix — KDE oturumunda panel + başlat menüsü garantisi.
#
# İki kırılma onarılır:
#  1) plasmashell hipervizörde (3D hızlandırma yok) çöküyor -> hiç panel yok.
#     Çözüm: yazılım GL ile bir kez yeniden başlat.
#  2) Özel look-and-feel ile açılan yeni profilde Plasma paneli hiç kurmuyor ->
#     masaüstü çıplak, başlat menüsü yok. Çözüm: Plasma betik API'siyle paneli kur.
#
# Sessiz çalışır, kararını /tmp/parametral-kde-fix.log dosyasına yazar.
set -u

case "${XDG_CURRENT_DESKTOP:-}" in
  *KDE*) ;;
  *) exit 0 ;;
esac

log=/tmp/parametral-kde-fix.log
say() { echo "[$(date -u +%FT%TZ)] $*" >> "$log" 2>/dev/null || true; }

# Başlat menüsü düğmesine gerçek Parametral logosunu koy (v0.1.23).
set_launcher_icon() {
  cfg="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
  [ -f "$cfg" ] || return 0
  command -v kwriteconfig6 >/dev/null 2>&1 || return 0
  aid="$(awk -F'[][]' '/^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$/{split($0,a,"]["); split(a[3],b,"]"); id=b[1]} /^plugin=org\.kde\.plasma\.kickoff$/{print id}' "$cfg" | head -1)"
  [ -n "$aid" ] || return 0
  cid="$(awk -F'[][]' '/^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$/{split($0,a,"]["); split(a[2],c,"]"); cont=c[1]} /^plugin=org\.kde\.plasma\.kickoff$/{print cont}' "$cfg" | head -1)"
  kwriteconfig6 --file "$cfg" --group Containments --group "${cid:-2}" --group Applets \
    --group "$aid" --group Configuration --group General --key icon parametral-start \
    2>/dev/null || true
  say "başlat dugmesi Parametral logosuna ayarlandi"
}

# ---- 1. plasmashell ayakta mı? -------------------------------------------------
alive=""
for _ in $(seq 1 20); do
  if pgrep -x plasmashell >/dev/null 2>&1; then alive=1; break; fi
  sleep 1
done

if [ -z "$alive" ]; then
  say "plasmashell yok — yazilim GL ile yeniden baslatiliyor"
  LIBGL_ALWAYS_SOFTWARE=1 setsid plasmashell --replace >/dev/null 2>&1 &
  for _ in $(seq 1 20); do
    pgrep -x plasmashell >/dev/null 2>&1 && break
    sleep 1
  done
fi

if ! pgrep -x plasmashell >/dev/null 2>&1; then
  say "plasmashell acilmadi — panel kurulamaz (GL/DRM sorunu)"
  exit 0
fi

# ---- 2. panel var mı? -----------------------------------------------------------
applets="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
if [ -f "$applets" ] && grep -q '^plugin=org\.kde\.plasma\.panel' "$applets"; then
  # Panel var ama eski profilde autohide kalmış olabilir: gizli panel = "menü yok" izlenimi.
  if grep -q '^hiding=autohide' "$applets"; then
    say "autohide acik — kapatiliyor"
    pkill -TERM -x plasmashell 2>/dev/null || true
    for _ in $(seq 1 6); do
      pgrep -x plasmashell >/dev/null 2>&1 || break
      sleep 1
    done
    sed -i 's/^hiding=autohide/hiding=none/' "$applets"
    LIBGL_ALWAYS_SOFTWARE=1 setsid plasmashell --replace >/dev/null 2>&1 &
    say "autohide kapatildi — panel artik sabit"
  else
    say "panel zaten var"
  fi
  set_launcher_icon
  exit 0
fi

layout=/usr/share/parametral/kde-layout.js
[ -f "$layout" ] || { say "kde-layout.js yok"; exit 0; }

for _ in $(seq 1 15); do
  if command -v qdbus6 >/dev/null 2>&1; then
    if qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
         "$(cat "$layout")" >>"$log" 2>&1; then
      say "panel kuruldu (kickoff + gorev cubugu + sistem tepsisi + saat)"
      set_launcher_icon
      exit 0
    fi
  fi
  sleep 2
done

say "panel kurulamadi — Plasma betik API'si yanit vermedi"
exit 0
